{
  "name": "storybook-pdf-export",
  "version": "0.1.0-alpha.4",
  "description": "Export a Storybook (docs pages and stories) into a single, print-friendly PDF with cover, table of contents, bookmarks and page numbers.",
  "type": "module",
  "license": "MIT",
  "author": "Artur Sopelnik",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/artursopelnik/storybook-pdf-export.git"
  },
  "keywords": [
    "storybook",
    "storybook-addon",
    "pdf",
    "export",
    "print",
    "design-system",
    "documentation",
    "chromatic",
    "corporate-design",
    "playwright"
  ],
  "bin": {
    "storybook-pdf-export": "./src/cli.js"
  },
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./preset": "./src/addon/preset.js",
    "./manager": "./src/addon/manager.js",
    "./print.css": "./src/print.css",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node test/run.mjs",
    "test:smoke": "npm --prefix test/fixtures/storybook install --no-audit --no-fund && node test/smoke.mjs",
    "prepublishOnly": "npm test && npm run test:types",
    "test:types": "tsc -p test/types"
  },
  "dependencies": {
    "pdf-lib": "^1.17.1",
    "playwright-core": "^1.50.0"
  },
  "peerDependencies": {
    "storybook": "^8.0.0 || ^9.0.0 || ^10.0.0"
  },
  "peerDependenciesMeta": {
    "storybook": {
      "optional": true
    }
  },
  "storybook": {
    "displayName": "PDF Export",
    "supportedFrameworks": [
      "react",
      "vue",
      "angular",
      "web-components",
      "html",
      "svelte",
      "preact"
    ]
  },
  "types": "./src/index.d.ts",
  "bugs": {
    "url": "https://github.com/artursopelnik/storybook-pdf-export/issues"
  },
  "homepage": "https://github.com/artursopelnik/storybook-pdf-export#readme",
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "tag": "alpha",
    "access": "public"
  }
}
